{
  "name": "shipshield-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ShipShield - Production-grade local-first security gate and DevSecOps platform",
  "type": "module",
  "engines": {
    "node": ">=18.19.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run build && npm run --workspaces --if-present typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "npm run typecheck",
    "shipshield": "node apps/cli/dist/index.js",
    "package:deb": "./packaging/build-deb.sh"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "yaml": "^2.9.1",
    "zod": "^3.24.1"
  }
}
