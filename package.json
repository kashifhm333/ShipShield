{
  "name": "shipshield-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ShipShield - Production-grade local-first security gate and DevSecOps platform",
  "type": "module",
  "engines": {
    "node": ">=18.19.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run build && npm run --workspaces --if-present typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "npm run typecheck",
    "shipshield": "node apps/cli/dist/index.js",
    "package:deb": "./packaging/build-deb.sh"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "supertest": "^7.3.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "bullmq": "^6.4.1",
    "commander": "^15.0.0",
    "cors": "^2.8.6",
    "diff": "^9.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.11.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  }
}
